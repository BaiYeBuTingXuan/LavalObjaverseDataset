# ==============================
# PROJECT-SPECIFIC EXCLUDES
# ==============================
# Blender installation (large binary distribution)
blender-*/ 
blender-*-linux-x64/
blender-*-windows-x64/
blender-*-macos/

# Agreements & legal docs (often contain PII)
agreements/
./agreements/  # Redundant but safe to keep both forms

# Test directories (temporary outputs)
test/
tests/
testing/

# Password-protected directories (security critical)
pwd/
passwords/
secrets/
keys/

# ==============================
# NETWORK & LOCK FILES
# ==============================
*.lock
!.gitignore.lock  # Exception: keep gitignore.lock if used
*.pid
*.sock

# ==============================
# MISCELLANEOUS
# ==============================
# Jupyter
.ipynb_checkpoints/
*.ipynb

# Editors
*.kate-swp
*.gedit-save

# Backup files
*.*~
*.bak
*.old
*.orig